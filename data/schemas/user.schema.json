{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.schema.json",
  "title": "User",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_version", "source_id", "synthetic", "user_id", "name", "persona", "profile", "budget", "styles", "favorite_colors", "avoid_colors", "occasions", "goals"],
  "properties": {
    "schema_version": {"const": 1},
    "data_version": {"const": "fixtures_v1.0"},
    "source_id": {"const": "fixtures"},
    "synthetic": {"const": true},
    "user_id": {"type": "string", "pattern": "^u[0-9]{2}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 20},
    "persona": {"const": "stylist"},
    "profile": {"enum": ["office", "travel", "student"]},
    "budget": {"enum": ["low", "mid", "high"]},
    "styles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["simple", "classic", "smart", "formal", "street", "sporty", "soft", "vintage", "business", "campus"]}},
    "favorite_colors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["black", "white", "gray", "navy", "beige", "brown", "khaki", "red", "pink", "orange", "yellow", "green", "blue", "purple", "multi"]}},
    "avoid_colors": {"type": "array", "uniqueItems": true, "items": {"enum": ["black", "white", "gray", "navy", "beige", "brown", "khaki", "red", "pink", "orange", "yellow", "green", "blue", "purple", "multi"]}},
    "occasions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["daily", "commute", "interview", "meeting", "date", "party", "travel", "outdoor", "home", "sports"]}},
    "goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["reliable", "modern", "comfortable", "polished", "low_key", "confident", "cool"]}}
  }
}
